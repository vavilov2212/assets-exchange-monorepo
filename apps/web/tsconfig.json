{
  "extends": "@assets-exchange-monorepo/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./build/",
    "sourceMap": true,
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": false,
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/_shared/*"
      ],
      "@features/*": [
        "src/_features/*"
      ],
      "@entities/*": [
        "src/_entities/*"
      ],
      "@widgets/*": [
        "src/_widgets/*"
      ],
      "@app/*": [
        "src/_app/*"
      ],
      "@pages/*": [
        "src/_pages/*"
      ]
    }
  },
  "include": [
    "./src",
    ".next/types/**/*.ts",
    "./next-env.d.ts"
  ],
  "exclude": [
    "./src/**/__tests__/*",
    ".next"
  ]
}
