{
  "extends": "@assets-exchange-monorepo/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./build/",
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "*": ["src/*"],
      "@shared/*": ["src/_shared/*"],
      "@features/*": ["src/_features/*"],
      "@entities/*": ["src/_entities/*"],
      "@widgets/*": ["src/_widgets/*"],
      "@app/*": ["src/_app/*"],
      "@pages/*": ["src/_pages/*"]
    },
    "rootDir": "."
  },
  "include": [
    "./src",
    ".next/types/**/*.ts",
  ],
  "exclude": ["./src/**/__tests__/*", ".next"]
}
