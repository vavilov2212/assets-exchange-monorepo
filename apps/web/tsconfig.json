{
  "extends": "@assets-exchange-monorepo/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./build/",
    "sourceMap": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "*": ["src/*"],
      "@shared/*": ["src/_shared/*"],
      "@features/*": ["src/_features/*"],
      "@entities/*": ["src/_entities/*"],
      "@widgets/*": ["src/_widgets/*"],
      "@app/*": ["src/_app/*"],
      "@pages/*": ["src/_pages/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "rootDir": "."
  },
  "include": [
    "./src",
    ".next/types/**/*.ts",
    "src/shared/types/global.d.ts",
    "src/shared/types/next-env-extension.d.ts"
  ],
  "exclude": ["./src/**/__tests__/*", ".next"]
}
